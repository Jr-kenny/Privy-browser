import("//testing/test.gni")

# Privy-owned Chromium component. This directory is copied into
# //components/privy_privacy by tools/bootstrap.py.

source_set("core") {
  sources = [
    "compute/deterministic_private_compute_provider.cc",
    "compute/deterministic_private_compute_provider.h",
    "compute/private_compute_provider.h",
    "compute/private_compute_types.h",
    "core/privacy_policy_engine.cc",
    "core/privacy_policy_engine.h",
    "core/privacy_types.cc",
    "core/privacy_types.h",
  ]

  deps = [
    "//base",
    "//url",
  ]
}

test("privy_privacy_unittests") {
  sources = [
    "compute/deterministic_private_compute_provider_unittest.cc",
    "core/privacy_policy_engine_unittest.cc",
  ]

  deps = [
    ":core",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
